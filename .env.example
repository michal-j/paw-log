# Names only, placeholder values. Real values live in Vercel and in a local .env (git-ignored).
# Demo mode: fictional data, no backend. Remove or set to false to use the real backend locally.
VITE_DEMO_MODE=true
# Supabase > Project Settings > API: the project URL and the anon / publishable key.
# Never put the secret (server) key here: it would ship to every browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
